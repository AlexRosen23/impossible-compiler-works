model cache_versioned "Cache-aside with a version check on fill (repaired)"
description "The database carries a version. The reader remembers the version it read and the fill succeeds only if the version is unchanged (a compare-and-set), so a stale fill is dropped."

var db          : 0..1 = 0
var version     : 0..1 = 0
var cache       : 0..1 = 0
var cache_valid : bool = false

process Writer {
  var pc : {start, updated, done} = start
  action update     when pc = start   { db := 1; version := version + 1; pc := updated }
  action invalidate when pc = updated { cache_valid := false; pc := done }
}

process Reader {
  var pc   : {start, read_db, done} = start
  var tmp  : 0..1 = 0
  var seen : 0..1 = 0
  action miss when pc = start and not cache_valid { tmp := db; seen := version; pc := read_db }
  action hit  when pc = start and cache_valid     { pc := done }
  action fill when pc = read_db and seen = version  { cache := tmp; cache_valid := true; pc := done }
  action drop when pc = read_db and seen != version { pc := done }
}

terminal Writer.pc = done and Reader.pc = done

invariant NoStaleCacheAtRest: (Writer.pc = done and Reader.pc = done and cache_valid) => cache = db
