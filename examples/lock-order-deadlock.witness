model lock_order_deadlock "Two locks taken in opposite order (deadlock)"
description "A takes lock1 then lock2; B takes lock2 then lock1. If each grabs its first lock, neither can ever take its second: a reachable state with no enabled action."

type Holder = {nobody, A, B}
var lock1 : Holder = nobody
var lock2 : Holder = nobody

process A {
  var pc : {start, has_one, has_both, done} = start
  action take_lock1 when pc = start   and lock1 = nobody { lock1 := A; pc := has_one }
  action take_lock2 when pc = has_one and lock2 = nobody { lock2 := A; pc := has_both }
  action release    when pc = has_both { lock1 := nobody; lock2 := nobody; pc := done }
}

process B {
  var pc : {start, has_one, has_both, done} = start
  action take_lock2 when pc = start   and lock2 = nobody { lock2 := B; pc := has_one }
  action take_lock1 when pc = has_one and lock1 = nobody { lock1 := B; pc := has_both }
  action release    when pc = has_both { lock1 := nobody; lock2 := nobody; pc := done }
}

terminal A.pc = done and B.pc = done

invariant ExclusiveLock1: not (A.pc = has_both and B.pc = has_both)
