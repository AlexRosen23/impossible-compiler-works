#!/usr/bin/env bash
# Install dependencies and fetch the pinned TLC release (checksum-verified). Safe to re-run.
set -euo pipefail
cd "$(dirname "$0")/.."
node -e 'const [a]=process.versions.node.split(".").map(Number); if (a<24) { console.error("Node 24+ is required (node:sqlite, TS type stripping)"); process.exit(1) }'
npm ci --no-audit --no-fund
JAR=tools/tla2tools.jar
PIN_SHA=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
URL=https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
mkdir -p tools
if [ ! -f "$JAR" ] || [ "$(shasum -a 256 "$JAR" | cut -d' ' -f1)" != "$PIN_SHA" ]; then
  if [ "${WITNESS_SKIP_TLC:-0}" = "1" ]; then echo "skipping TLC download (WITNESS_SKIP_TLC=1): the app runs INTERNAL_ONLY"; else
    echo "downloading TLC v1.7.4 (MIT licence, tlaplus/tlaplus) ..."
    # HTTPS only (also on redirects), fail on HTTP errors, and never leave a partial file behind.
    if ! curl -fsSL --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 -o "$JAR.part" "$URL"; then
      rm -f "$JAR.part"; echo "TLC download failed; nothing installed. The app still runs (INTERNAL_ONLY). Re-run scripts/setup to retry."; exit 1
    fi
    GOT=$(shasum -a 256 "$JAR.part" | cut -d' ' -f1)
    if [ "$GOT" != "$PIN_SHA" ]; then rm -f "$JAR.part"; echo "checksum mismatch ($GOT); refusing to install"; exit 1; fi
    mv "$JAR.part" "$JAR"
  fi
fi
echo "setup done. Next: scripts/doctor, then scripts/dev"
