#!/usr/bin/env bash
# THE IMPOSSIBLE COMPILER WORKS gate: typecheck (both wings), lint (Compiler wing), unit/integration tests for both
# wings and the bridge, legacy receipt replay, and the reproduce scripts.
#   --e2e   browser journeys for both wings (Playwright, ports 5726/5727)
#   --tlc   live TLC cross-check of the Witness corpus (needs Java or Docker + scripts/setup)
#   --fuzz  the Compiler wing's differential fuzzer (2000 programs)
set -euo pipefail
cd "$(dirname "$0")/.."
npx tsc -p tsconfig.json
npx tsc -p web/tsconfig.json
npx tsc -p wings/compiler/tsconfig.json
(cd wings/compiler && npx eslint .)
node --test --test-reporter=spec tests/*.test.ts
(cd wings/compiler && NODE_NO_WARNINGS=1 npx vitest run)
node --test --test-reporter=spec bridge/tests/*.test.ts
./scripts/reproduce
if [[ " $* " == *" --fuzz "* ]]; then NODE_NO_WARNINGS=1 node wings/compiler/scripts/fuzz.ts 2000; fi
if [[ " $* " == *" --tlc "* ]]; then node scripts/corpus.ts --tlc; fi
if [[ " $* " == *" --e2e "* ]]; then npx playwright test; fi
