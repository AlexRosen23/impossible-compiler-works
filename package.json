{
  "name": "impossible-witness",
  "version": "0.1.0",
  "private": true,
  "description": "THE IMPOSSIBLE WITNESS — a visual formal-methods laboratory: finite transition systems, BFS model checking, counterexample traces, fairness-aware liveness, TLC cross-checks and replayable evidence receipts.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test --test-reporter=spec tests/*.test.ts",
    "server": "node src/server/main.ts",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "witness": "node src/cli/witness.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
