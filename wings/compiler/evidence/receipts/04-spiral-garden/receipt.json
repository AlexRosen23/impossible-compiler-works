  "source": "// User-defined functions with local returns, called from a bounded loop.\nfn golden(i: Number) -> Number {\n  return i * 137.508 * PI / 180;\n}\n\nfn petalRadius(i: Number, count: Number) -> Number {\n  if i < count / 3 {\n    return 2 + i * 0.04;\n  }\n  return 3 + sqrt(i) * 0.35;\n}\n\nscene \"Spiral Garden\" size 800 x 480 background #101013 {\n  let n = 420;\n  repeat i in 0..n {\n    let a = golden(i);\n    let d = sqrt(i) * 10.5;\n    circle(\n      x: WIDTH / 2 + cos(a) * d,\n      y: HEIGHT / 2 + sin(a) * d,\n      radius: petalRadius(i, n),\n      fill: mix(#b2534f, #bb9c67, i / n)\n    );\n  }\n}\n",
