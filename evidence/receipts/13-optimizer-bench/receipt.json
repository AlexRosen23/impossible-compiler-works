  "source": "// Built for the Optimization Duel: constants to fold, a dead debug branch, repeated subexpressions.\nscene \"Optimizer Bench\" size 800 x 480 frames 30 background #101013 {\n  let debug = false;\n  let unit = 360 / 24;\n  let scale = 2 * 3 + 4;\n  repeat i in 0..400 {\n    let a = (i * unit + time * 360) * PI / 180;  // the same angle is recomputed below on purpose (CSE)\n    let r = 60 + (i % 40) * scale / 2;\n    if debug {\n      text(x: 10, y: 10, value: \"debug \" + str(i), size: 9);\n    }\n    circle(\n      x: 400 + cos(a) * r,\n      y: 240 + sin((i * unit + time * 360) * PI / 180) * r * 0.55,\n      radius: 2 + (i % 5),\n      fill: hsl(i * unit, 0.5, 0.6)\n    );\n  }\n}\n",
